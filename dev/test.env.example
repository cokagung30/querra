# Local database servers for integration tests. Copy this file to dev/test.env
# (git-ignored) and adjust it to your machine. Taskfile.yml loads dev/test.env
# automatically.
#
# `wails3 task db:reset` uses the admin account to create the database
# querra_test (plus querra_test_sales on MySQL/MariaDB) and the user
# querra_test / querra_test, then loads dev/seed. Integration tests connect as
# querra_test. Nothing else on the server is touched.
#
# Leave an engine's HOST empty to skip it; CI covers every engine.

# PostgreSQL
QUERRA_DEV_POSTGRES_HOST=127.0.0.1
QUERRA_DEV_POSTGRES_PORT=5432
QUERRA_DEV_POSTGRES_ADMIN_USER=postgres
QUERRA_DEV_POSTGRES_ADMIN_PASSWORD=

# MySQL
QUERRA_DEV_MYSQL_HOST=127.0.0.1
QUERRA_DEV_MYSQL_PORT=3306
QUERRA_DEV_MYSQL_ADMIN_USER=root
QUERRA_DEV_MYSQL_ADMIN_PASSWORD=

# MariaDB
QUERRA_DEV_MARIADB_HOST=
QUERRA_DEV_MARIADB_PORT=3307
QUERRA_DEV_MARIADB_ADMIN_USER=root
QUERRA_DEV_MARIADB_ADMIN_PASSWORD=
