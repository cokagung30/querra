    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "i18next": "^27.0.1",
    "lucide-react": "^1.70.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^18.0.0",
