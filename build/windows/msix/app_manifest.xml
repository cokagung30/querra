<?xml version="1.0" encoding="utf-8"?>
<!--
  Hand-maintained MSIX manifest for the Microsoft Store (PLAN §8.1, M0.5).
  Identity Name, Publisher and PublisherDisplayName come from Partner Center
  (Product management → Product identity) and must match it exactly; they are
  public, not secrets. Each Store submission needs a higher Version, and the
  last of its four parts must stay 0.
  `wails3 task common:update:build-assets` overwrites this file: restore it
  from git afterwards.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">

  <Identity
    Name="BaliDigitalKarya.Querra"
    Publisher="CN=D674B8A2-7FFA-4BFB-AFD0-709702A95026"
    Version="0.1.0.0"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Querra</DisplayName>
    <PublisherDisplayName>Bali Digital Karya</PublisherDisplayName>
    <Description>Lightweight database client for PostgreSQL, MySQL/MariaDB and SQLite</Description>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <!-- Windows 10 1809 and later. WebView2 must already be installed: an
         MSIX package cannot run the WebView2 bootstrapper the NSIS installer
         ships with (PLAN R7). -->
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="Querra" Executable="querra.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Querra"
        Description="Lightweight database client"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" />
      </uap:VisualElements>
    </Application>
  </Applications>

  <Capabilities>
    <!-- A regular desktop app: no sandbox, so no network capability is needed. -->
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
